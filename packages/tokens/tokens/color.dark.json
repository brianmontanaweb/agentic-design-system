{
  "color": {
    "surface": {
      "base": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0392, 0.0392, 0.0588],
          "alpha": 1,
          "hex": "#0a0a0f"
        },
        "$type": "color",
        "$description": "Darkest background layer"
      },
      "default": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0745, 0.0745, 0.102],
          "alpha": 1,
          "hex": "#13131a"
        },
        "$type": "color",
        "$description": "Default surface"
      },
      "elevated": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1098, 0.1098, 0.149],
          "alpha": 1,
          "hex": "#1c1c26"
        },
        "$type": "color",
        "$description": "Elevated surface — cards, popovers"
      },
      "step": {
        "active": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.302, 0.6235, 1],
            "alpha": 0.1333,
            "hex": "#4d9fff"
          },
          "$type": "color",
          "$description": "Active step background tint — alpha 0x22 ≈ 13% over the step circle background"
        },
        "complete": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.2392, 0.8392, 0.549],
            "alpha": 0.1333,
            "hex": "#3dd68c"
          },
          "$type": "color",
          "$description": "Complete step background tint"
        },
        "waiting": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.9608, 0.6196, 0.0431],
            "alpha": 0.1333,
            "hex": "#f59e0b"
          },
          "$type": "color",
          "$description": "Waiting step background tint"
        }
      }
    },
    "border": {
      "subtle": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1647, 0.1647, 0.2196],
          "alpha": 1,
          "hex": "#2a2a38"
        },
        "$type": "color",
        "$description": "Low-contrast divider and border"
      }
    },
    "text": {
      "primary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9412, 0.9412, 0.9608],
          "alpha": 1,
          "hex": "#f0f0f5"
        },
        "$type": "color",
        "$description": "High-contrast body text"
      },
      "muted": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.5333, 0.5333, 0.6667],
          "alpha": 1,
          "hex": "#8888aa"
        },
        "$type": "color",
        "$description": "De-emphasized or secondary text"
      },
      "on": {
        "accent": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.0392, 0.0392, 0.0588],
            "alpha": 1,
            "hex": "#0a0a0f"
          },
          "$type": "color",
          "$description": "Text on accent backgrounds. Dark mode accents are light pastels — white text fails WCAG AA (≈2.7:1), so use near-black (surface.base) for >7:1 contrast"
        },
        "danger": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.0392, 0.0392, 0.0588],
            "alpha": 1,
            "hex": "#0a0a0f"
          },
          "$type": "color",
          "$description": "Text on the danger background. Fixed independently of color.text.on.accent — a custom theme accent (e.g. a dark brand purple) can flip on.accent to white, which fails against dark mode's light salmon danger red (≈2.8:1); near-black holds >7:1 here regardless of theme"
        }
      }
    },
    "accent": {
      "interactive": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.302, 0.6235, 1],
          "alpha": 1,
          "hex": "#4d9fff"
        },
        "$type": "color",
        "$description": "Primary interactive accent"
      },
      "success": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.2392, 0.8392, 0.549],
          "alpha": 1,
          "hex": "#3dd68c"
        },
        "$type": "color",
        "$description": "Success and done state"
      },
      "warning": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9608, 0.6196, 0.0431],
          "alpha": 1,
          "hex": "#f59e0b"
        },
        "$type": "color",
        "$description": "Warning and waiting state"
      },
      "danger": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9725, 0.4431, 0.4431],
          "alpha": 1,
          "hex": "#f87171"
        },
        "$type": "color",
        "$description": "Error and danger state"
      }
    }
  }
}
